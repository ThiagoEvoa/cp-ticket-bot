{
    "title": "login",
    "steps": [
        {
            "type": "setViewport",
            "width": 1350,
            "height": 963,
            "deviceScaleFactor": 1,
            "isMobile": false,
            "hasTouch": false,
            "isLandscape": false
        },
        {
            "type": "navigate",
            "url": "https://www.cp.pt/pt",
            "assertedEvents": [
                {
                    "type": "navigation",
                    "url": "https://www.cp.pt/pt",
                    "title": "CP - Comboios de Portugal | Bilhetes de Comboio Online"
                }
            ]
        },
        {
            "type": "click",
            "target": "main",
            "selectors": [
                [
                    "aria/Email"
                ],
                [
                    "#username"
                ],
                [
                    "xpath///*[@id=\"username\"]"
                ],
                [
                    "pierce/#username"
                ]
            ],
            "offsetY": 9,
            "offsetX": 247.5
        },
        {
            "type": "change",
            "value": "configured-email",
            "selectors": [
                [
                    "aria/Email"
                ],
                [
                    "#username"
                ],
                [
                    "xpath///*[@id=\"username\"]"
                ],
                [
                    "pierce/#username"
                ]
            ],
            "target": "main"
        },
        {
            "type": "keyUp",
            "key": "2",
            "target": "main"
        },
        {
            "type": "change",
            "value": "configured-email",
            "selectors": [
                [
                    "aria/Email"
                ],
                [
                    "#username"
                ],
                [
                    "xpath///*[@id=\"username\"]"
                ],
                [
                    "pierce/#username"
                ]
            ],
            "target": "main"
        },
        {
            "type": "click",
            "target": "main",
            "selectors": [
                [
                    "aria/Palavra-passe"
                ],
                [
                    "#password"
                ],
                [
                    "xpath///*[@id=\"password\"]"
                ],
                [
                    "pierce/#password"
                ]
            ],
            "offsetY": 4,
            "offsetX": 31.5
        },
        {
            "type": "change",
            "value": "configured-password",
            "selectors": [
                [
                    "aria/Palavra-passe"
                ],
                [
                    "#password"
                ],
                [
                    "xpath///*[@id=\"password\"]"
                ],
                [
                    "pierce/#password"
                ]
            ],
            "target": "main"
        },
        {
            "type": "keyUp",
            "key": "e",
            "target": "main"
        },
        {
            "type": "change",
            "value": "configured-password",
            "selectors": [
                [
                    "aria/Palavra-passe"
                ],
                [
                    "#password"
                ],
                [
                    "xpath///*[@id=\"password\"]"
                ],
                [
                    "pierce/#password"
                ]
            ],
            "target": "main"
        },
        {
            "type": "keyDown",
            "target": "main",
            "key": "Enter",
            "assertedEvents": [
                {
                    "type": "navigation",
                    "url": "https://www.cp.pt/pt/login-check",
                    "title": ""
                }
            ]
        },
        {
            "type": "keyUp",
            "key": "Enter",
            "target": "main",
            "assertedEvents": [
                {
                    "type": "navigation",
                    "url": "https://www.cp.pt/pt/mycp",
                    "title": ""
                }
            ]
        }
    ]
}
